    { "name": "different song", "wanted": { "title": "Song", "artist": "A" }, "candidate": { "title": "Song Two", "artist": "A" }, "same": false },
    { "name": "different artist", "wanted": { "title": "Song", "artist": "A" }, "candidate": { "title": "Song", "artist": "Zed" }, "same": false },
    { "name": "cover with feat. credit", "wanted": { "title": "Song", "artist": "A feat. B" }, "candidate": { "title": "Song", "artist": "A" }, "same": true }
