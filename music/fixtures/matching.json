    { "name": "same ISRC wins even with different titles", "wanted": { "title": "Song", "artist": "A", "isrc": "ZZ1" }, "candidate": { "title": "Other", "artist": "B", "isrc": "zz1" }, "same": true },
    { "name": "different ISRC loses even with same title", "wanted": { "title": "Song", "artist": "A", "isrc": "ZZ1" }, "candidate": { "title": "Song", "artist": "A", "isrc": "ZZ2" }, "same": false },
