    { "name": "same title and artist, lengths 10 s apart", "wanted": { "title": "Song", "artist": "A", "durationMs": 200000 }, "candidate": { "title": "Song", "artist": "A", "durationMs": 210000 }, "same": false },
    { "name": "length unknown on one side", "wanted": { "title": "Song", "artist": "A" }, "candidate": { "title": "Song", "artist": "A", "durationMs": 210000 }, "same": true },
